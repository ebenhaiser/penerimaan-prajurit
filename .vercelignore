# ====================================================================
# .vercelignore - Root Configuration for Vercel Deployment
# Sistem Penerimaan Prajurit Terintegrasi Berbasis AI
# ====================================================================

# Backend & Server Files (Vercel builds the Frontend SPA)
backend/

# Database & Migrations
database/
migrations/
*.sql

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Local Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env*
frontend/.env.local

# Git & Repository Metadata
.git/
.github/
.gitignore

# Uploads & Temporary Local Storage
uploads/
scratch/
tmp/
temp/

# Tests & Documentation
tests/
coverage/
PRD.md
*.md
!frontend/README.md

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
