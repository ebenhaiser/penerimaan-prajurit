# ====================================================================
# .gitignore - Sistem Penerimaan Prajurit Terintegrasi Berbasis AI
# ====================================================================

# Dependency Directories
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & Secrets (PRD NFR-01: Jangan commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
*.env
!*.env.example

# Production Builds
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/
.vercel/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads & Temporary Storage
uploads/*
!uploads/.gitkeep
scratch/
tmp/
temp/

# Testing & Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
